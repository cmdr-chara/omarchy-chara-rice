#!/usr/bin/env bash
set -euo pipefail

assets_dir="${CHARA_WALLPAPER_ASSETS_DIR:-$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/assets}"
workshop_id="${CHARA_WALLPAPER_ID:-3450338231}"
fps="${CHARA_WALLPAPER_FPS:-30}"
monitor="${CHARA_WALLPAPER_MONITOR:-auto}"

command -v linux-wallpaperengine >/dev/null 2>&1 || exit 0
[[ -d $assets_dir ]] || exit 0
[[ $workshop_id =~ ^[0-9]+$ ]] || {
  printf 'CHARA_WALLPAPER_ID must contain only digits.\n' >&2
  exit 2
}
[[ $fps =~ ^[0-9]+$ ]] && (( fps >= 1 && fps <= 60 )) || {
  printf 'CHARA_WALLPAPER_FPS must be between 1 and 60.\n' >&2
  exit 2
}

if [[ $monitor == auto ]]; then
  monitor="$(hyprctl -j monitors 2>/dev/null | jq -r '[.[] | select(.focused)][0].name // .[0].name // empty')"
fi
[[ -n $monitor ]] || {
  printf 'No active Hyprland monitor found.\n' >&2
  exit 1
}

exec linux-wallpaperengine \
  --silent \
  --screen-root "$monitor" \
  --assets-dir "$assets_dir" \
  --fps "$fps" \
  "$workshop_id"
